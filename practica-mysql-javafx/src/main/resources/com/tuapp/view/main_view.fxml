<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="420.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tuapp.controller.MainController">

    <!-- Parte superior: ComboBox de Categorías -->
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;"
                   text="Catálogo de Productos por Categoría" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Categoría:" />
                <ComboBox fx:id="comboCategorias"
                           prefWidth="240.0"
                          promptText="Seleccione una categoría..." />
            </HBox>
        </VBox>
    </top>

    <!-- Parte central: TableView de Productos -->
    <center>
        <VBox BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="4.0" />
            </padding>
            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" prefWidth="230.0" text="Nombre" />
                    <TableColumn fx:id="colPrecio" prefWidth="140.0" text="Precio" />
                    <TableColumn fx:id="colCategoria" prefWidth="190.0" text="Categoría" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>
